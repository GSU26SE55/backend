# Copy to /opt/solar-platform/config/host.env on the backend + IoT VPS.
# This file contains deployment configuration only, not application secrets.
PLATFORM_PUBLIC_DOMAIN=solars.io.vn
PLATFORM_PUBLIC_IPV4=116.118.6.33
# R4 has no provider-private NIC. Its local WireGuard address is stable and is
# used for same-host K3s -> Docker MQTT routing without public-IP hairpinning.
PLATFORM_PRIVATE_IPV4=10.20.0.1
ACME_EMAIL=buiphuocthang2507@gmail.com
# Browser origin only: no path and no trailing slash.
FRONTEND_PUBLIC_ORIGIN=https://solars.io.vn
# /docs is documentation only. Both application clients use the origin below.
AI_GRPC_ADDRESS=https://ai.solars.io.vn
AI_HTTP_BASE_URL=https://ai.solars.io.vn
MQTT_NODE_IP=10.20.0.1
MQTT_AUTH_DIR=/opt/solar-iot/secrets/mosquitto/auth
# The unprivileged deploy user must own/read this copy. Keep the root-only
# /etc/rancher/k3s/k3s.yaml for systemd maintenance units only.
KUBECONFIG=/home/deploy/.kube/config
K3S_NAMESPACE=solar-prod
HELM_RELEASE=solar
# Use bootstrap only for the first Helm install. After Loki exists and R3 AI is
# connected to it, change this permanently to steady before the second deploy.
PLATFORM_DEPLOYMENT_PHASE=bootstrap
AI_WIREGUARD_IPV4=10.20.0.2
PLATFORM_WIREGUARD_IPV4=10.20.0.1

# GH-1244 — TicketService periodic maintenance scheduler.
TICKET_PERIODIC_MAINTENANCE_ENABLED=true
TICKET_PERIODIC_MAINTENANCE_TIME_ZONE_ID=Asia/Ho_Chi_Minh
TICKET_PERIODIC_MAINTENANCE_CYCLE_MONTHS=6
TICKET_PERIODIC_MAINTENANCE_LEAD_DAYS=7
TICKET_PERIODIC_MAINTENANCE_OVERDUE_WINDOW_DAYS=7
TICKET_PERIODIC_MAINTENANCE_REMINDER_TIME=08:00:00
TICKET_PERIODIC_MAINTENANCE_POLL_INTERVAL_SECONDS=60
TICKET_PERIODIC_MAINTENANCE_BATCH_SIZE=100

# TicketService SLA business calendar.
SLA_BUSINESS_HOURS_TIME_ZONE_ID=Asia/Ho_Chi_Minh
SLA_BUSINESS_HOURS_START=07:00:00
SLA_BUSINESS_HOURS_END=17:00:00
SLA_BUSINESS_HOURS_WORKING_DAYS_0=Sunday
SLA_BUSINESS_HOURS_WORKING_DAYS_1=Monday
SLA_BUSINESS_HOURS_WORKING_DAYS_2=Tuesday
SLA_BUSINESS_HOURS_WORKING_DAYS_3=Wednesday
SLA_BUSINESS_HOURS_WORKING_DAYS_4=Thursday
SLA_BUSINESS_HOURS_WORKING_DAYS_5=Friday
SLA_BUSINESS_HOURS_WORKING_DAYS_6=Saturday
