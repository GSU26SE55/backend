{
  "annotations": { "list": [] },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "id": null,
  "links": [],
  "liveNow": false,
  "panels": [
    {
      "type": "row",
      "title": "Host (node-exporter)",
      "id": 100,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 0 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "CPU Usage",
      "id": 1,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "100 - (avg(rate(node_cpu_seconds_total{mode=\"idle\"}[1m])) * 100)",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "stat",
      "title": "Memory Used",
      "id": 2,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(node_memory_MemTotal_bytes - node_memory_MemAvailable_bytes) / node_memory_MemTotal_bytes * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "stat",
      "title": "Disk Used (/)",
      "id": 3,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "(1 - node_filesystem_avail_bytes{mountpoint=\"/\"} / node_filesystem_size_bytes{mountpoint=\"/\"}) * 100",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "stat",
      "title": "Network RX/TX",
      "id": 4,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 1 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "sum(rate(node_network_receive_bytes_total[1m]))", "legendFormat": "RX", "refId": "A" },
        { "expr": "sum(rate(node_network_transmit_bytes_total[1m]))", "legendFormat": "TX", "refId": "B" }
      ],
      "fieldConfig": { "defaults": { "unit": "Bps" } }
    },
    {
      "type": "row",
      "title": "Containers (cAdvisor)",
      "id": 200,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 5 },
      "collapsed": false
    },
    {
      "type": "timeseries",
      "title": "Container CPU usage",
      "id": 5,
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "description": "Filter by id — `name` label not available on Docker Desktop Mac (containerd socket missing). Cross-platform query.",
      "targets": [
        {
          "expr": "label_replace(sum(rate(container_cpu_usage_seconds_total{id=~\"/docker/.+\"}[1m])) by (id) * 100, \"container_id\", \"$1\", \"id\", \"/docker/(.{12}).*\")",
          "legendFormat": "{{container_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "percent" } }
    },
    {
      "type": "timeseries",
      "title": "Container Memory usage",
      "id": 6,
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 6 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        {
          "expr": "label_replace(container_memory_working_set_bytes{id=~\"/docker/.+\"}, \"container_id\", \"$1\", \"id\", \"/docker/(.{12}).*\")",
          "legendFormat": "{{container_id}}",
          "refId": "A"
        }
      ],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "row",
      "title": "Postgres",
      "id": 300,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 14 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Connections",
      "id": 7,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(pg_stat_activity_count)", "refId": "A" }]
    },
    {
      "type": "timeseries",
      "title": "Postgres TPS",
      "id": 8,
      "gridPos": { "h": 8, "w": 18, "x": 6, "y": 15 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [
        { "expr": "rate(pg_stat_database_xact_commit{datname!~\"template.*|postgres\"}[1m])", "legendFormat": "{{datname}} commit", "refId": "A" },
        { "expr": "rate(pg_stat_database_xact_rollback{datname!~\"template.*|postgres\"}[1m])", "legendFormat": "{{datname}} rollback", "refId": "B" }
      ]
    },
    {
      "type": "row",
      "title": "Redis & RabbitMQ",
      "id": 400,
      "gridPos": { "h": 1, "w": 24, "x": 0, "y": 23 },
      "collapsed": false
    },
    {
      "type": "stat",
      "title": "Redis Connected Clients",
      "id": 9,
      "gridPos": { "h": 4, "w": 6, "x": 0, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_connected_clients", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Redis Memory",
      "id": 10,
      "gridPos": { "h": 4, "w": 6, "x": 6, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "redis_memory_used_bytes", "refId": "A" }],
      "fieldConfig": { "defaults": { "unit": "bytes" } }
    },
    {
      "type": "stat",
      "title": "RabbitMQ Queue Messages",
      "id": 11,
      "gridPos": { "h": 4, "w": 6, "x": 12, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "sum(rabbitmq_queue_messages)", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "RabbitMQ Connections",
      "id": 12,
      "gridPos": { "h": 4, "w": 6, "x": 18, "y": 24 },
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "targets": [{ "expr": "rabbitmq_connections", "refId": "A" }]
    }
  ],
