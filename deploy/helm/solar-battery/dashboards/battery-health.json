  "description": "Sprint 7 #117 — Battery Health (aggregate SOH/DCIR/Imbalance). Metrics từ BatteryService.Infrastructure.Observability.BatteryHealthMetrics. Per-asset detail xem web app qua Reports API #114.",
  "editable": true,
  "graphTooltip": 0,
  "id": null,
  "links": [],
  "liveNow": false,
  "schemaVersion": 39,
  "tags": ["solar-battery", "battery-health", "soh", "sprint-7"],
  "templating": { "list": [] },
  "time": { "from": "now-6h", "to": "now" },
  "timepicker": { "refresh_intervals": ["30s", "1m", "5m"] },
  "refresh": "30s",
  "title": "Sprint 7 — Battery Health",
  "uid": "solar-battery-health",
  "version": 1,
  "panels": [
    {
      "type": "gauge",
      "title": "Avg SOH (%)",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
        { "expr": "battery_soh_avg_percent", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "red", "value": null }, { "color": "orange", "value": 80 }, { "color": "green", "value": 90 } ] } } }
    },
    {
      "type": "stat",
      "title": "Batteries below SOH threshold",
      "id": 2,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 0, "w": 8, "h": 4 },
      "targets": [
        { "expr": "batteries_below_soh_threshold_count", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "decimals": 0, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "red", "value": 1 } ] } } }
    },
    {
      "type": "stat",
      "title": "Avg DCIR (mΩ)",
      "id": 3,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 16, "y": 0, "w": 8, "h": 4 },
      "targets": [
        { "expr": "battery_dcir_avg_milliohm", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 100 } ] } } }
    },
    {
      "type": "stat",
      "title": "Max cell imbalance (mV)",
      "id": 4,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 8, "y": 4, "w": 16, "h": 4 },
      "targets": [
        { "expr": "battery_cell_imbalance_max_mv", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "none", "decimals": 1, "color": { "mode": "thresholds" }, "thresholds": { "steps": [ { "color": "green", "value": null }, { "color": "orange", "value": 50 }, { "color": "red", "value": 100 } ] } } }
    },
    {
      "type": "timeseries",
      "title": "Avg SOH (over time)",
      "id": 5,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "battery_soh_avg_percent", "legendFormat": "avg SOH %", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "unit": "percent", "min": 0, "max": 100, "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    },
    {
      "type": "timeseries",
      "title": "DCIR & Cell imbalance (over time)",
      "id": 6,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 12, "y": 8, "w": 12, "h": 8 },
      "targets": [
        { "expr": "battery_dcir_avg_milliohm", "legendFormat": "DCIR avg (mΩ)", "refId": "A", "datasource": { "type": "prometheus", "uid": "prometheus" } },
        { "expr": "battery_cell_imbalance_max_mv", "legendFormat": "Imbalance max (mV)", "refId": "B", "datasource": { "type": "prometheus", "uid": "prometheus" } }
      ],
      "fieldConfig": { "defaults": { "custom": { "drawStyle": "line", "fillOpacity": 10 } } }
    }
  ]
}
