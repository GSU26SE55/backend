  "panels": [
    {
      "type": "gauge",
      "title": "SLA Compliance (%)",
      "id": 1,
      "datasource": { "type": "prometheus", "uid": "prometheus" },
      "gridPos": { "x": 0, "y": 0, "w": 8, "h": 8 },
      "targets": [
