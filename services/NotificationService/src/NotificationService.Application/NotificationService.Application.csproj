<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
    </PropertyGroup>

    <ItemGroup>
      <ProjectReference Include="..\..\..\..\shared\src\SharedContracts\SharedContracts.csproj" />
      <ProjectReference Include="..\..\..\..\shared\src\SharedInfrastructure\SharedInfrastructure.csproj" />
      <ProjectReference Include="..\NotificationService.Domain\NotificationService.Domain.csproj" />
    </ItemGroup>

    <ItemGroup>
        <PackageReference Include="Handlebars.Net" Version="2.1.6" />
        <PackageReference Include="MediatR" Version="12.2.0" />
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.2" />
    </ItemGroup>

    <ItemGroup>
        <!-- Template email nhúng thẳng vào assembly (HandlebarsTemplateRenderer đọc qua
             GetManifestResourceStream). Trước đây là *.hbs — đổi sang *.html để mở bằng
             trình duyệt/IDE xem trước được ngay; cú pháp bên trong vẫn là Handlebars. -->
        <EmbeddedResource Include="Templates\*.html" />
    </ItemGroup>

</Project>
