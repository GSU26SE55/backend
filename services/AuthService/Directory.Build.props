<Project>

  <!-- Import root Directory.Build.props (Sprint audit #AUDIT-04 banned-API gate) — MSBuild dừng ở file gần nhất nên phải import thủ công.
       Conditional qua property trung gian: bỏ qua nếu không tìm thấy (vd Docker build context KHÔNG copy root props) → tránh vỡ build. -->
  <PropertyGroup>
    <_RootBuildPropsPath>$([MSBuild]::GetPathOfFileAbove('Directory.Build.props', '$(MSBuildThisFileDirectory)../'))</_RootBuildPropsPath>
  </PropertyGroup>
  <Import Project="$(_RootBuildPropsPath)" Condition="'$(_RootBuildPropsPath)' != ''" />

  <!--
    #AUTH-81 — Async/await anti-pattern enforcement cho AuthService.
    Apply cho TẤT CẢ project con (Api/Application/Domain/Infrastructure + Tests).
    Roslyn analyzer:
      - VSTHRD002: cấm .Result / .Wait() / .GetAwaiter().GetResult() (sync-over-async deadlock risk)
      - VSTHRD100: cấm async void method (exception bị nuốt + crash process)
      - VSTHRD110: cấm gọi async method mà không await/observe Task
      - CA2200:    throw; thay throw ex; (preserve stack trace)
    Severity được set trong .editorconfig (root) — search "AUTH-81".
  -->

  <PropertyGroup>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
    <AnalysisMode>Default</AnalysisMode>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.VisualStudio.Threading.Analyzers" Version="17.10.48">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

</Project>
