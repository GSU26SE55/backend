{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TicketDb": "",
    "Redis": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": ""
  },
  "MessageBus": {
    "PrefetchCount": 16,
    "ConcurrentMessageLimit": 8
  },
  "AlertTicketSaga": {
    "AlertTicketDispatchEnabled": true,
    "AlertTicketSagaEnabled": true
  },
  "Chat": {
    "EditWindowMinutes": 15,
    "MinBodyLength": 1,
    "MaxBodyLength": 10000,
    "BlockEditOnClosed": true,
    "MaxAttachmentsPerChat": 10,
    "MaxAttachmentSizeBytes": 52428800,
    "AllowedAttachmentMimeTypes": [ "image/*", "application/pdf", "video/mp4", "text/plain" ],
    "ProfanityWords": {
      "VN": [ "đồ ngu", "ngu", "đồ khốn", "đần độn" ],
      "EN": [ "idiot", "stupid", "damn", "moron" ]
    },
    "Retention": {
      "ArchiveAfterYears": 2
    },
    "Ai": {
      "ApiKey": "",
      "SuggestModelEndpoint": "https://generativelanguage.googleapis.com/v1beta/models/gemini-2.0-flash-lite:generateContent",
      "MaxSuggestionsPerCall": 3,
      "TimeoutSeconds": 15,
      "PiiMaskTtlHours": 1
    },
    "Features": {
      "EnableVirusScan": false
    },
    "Voice": {
      "AllowedAudioMimeTypes": [ "audio/mpeg", "audio/wav", "audio/ogg", "audio/webm", "audio/mp4", "audio/flac" ],
      "TranscribeModelEndpoint": "https://generativelanguage.googleapis.com/v1beta/models/gemini-1.5-flash:generateContent",
      "FileStorageUploadUrl": "http://file-storage-service/api/files/upload",
      "TranscribeTimeoutSeconds": 30
    },
    "VirusScan": {
      "Endpoint": "http://clamav:3000",
      "TimeoutSeconds": 60,
      "BatchSize": 20,
      "IntervalSeconds": 30,
      "FileStorageBaseUrl": "http://file-storage-service"
    }
  }
}
