{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ConnectionStrings": {
    "TicketDb": "",
    "Redis": ""
  },
  "JwtSettings": {
    "SecretKey": "",
    "Issuer": "",
    "Audience": ""
  },
  "MessageBus": {
    "PrefetchCount": 16,
    "ConcurrentMessageLimit": 8
  },
  "AlertTicketSaga": {
    "AlertTicketDispatchEnabled": true,
    "AlertTicketSagaEnabled": true
  },
  "Chat": {
    "EditWindowMinutes": 15,
    "MinBodyLength": 1,
    "MaxBodyLength": 10000,
    "MaxAttachmentsPerChat": 10,
    "MaxAttachmentSizeBytes": 52428800,
    "AllowedAttachmentMimeTypes": [ "image/*", "application/pdf", "video/mp4", "text/plain" ]
  }
}
