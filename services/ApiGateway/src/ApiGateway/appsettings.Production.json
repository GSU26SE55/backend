{
  "//GH-787": [
    "Production KHÔNG có file này ⇒ chỉ appsettings.json được nạp, mà file đó trỏ mọi cluster về",
    "https://localhost:7000/7100/7200/... — trong container, localhost CHÍNH LÀ ApiGateway, không",
    "phải microservice. Hậu quả: mọi route proxy ở production trả 502 (connection refused).",
    "docker-compose.prod.yml đặt ASPNETCORE_ENVIRONMENT=Production và KHÔNG override ReverseProxy__,",
    "nên không có gì cứu được. File này đưa destination về DNS nội bộ của container.",
    "Muốn trỏ đi nơi khác (host riêng, service mesh) thì override bằng biến môi trường",
    "ReverseProxy__Clusters__<tên>__Destinations__destination1__Address — env luôn thắng file."
  ],
  "ReverseProxy": {
    "Clusters": {
      "authCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://authservice:8080"
          }
        }
      },
      "fileStorageCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://filestorageservice:8080"
          }
        }
      },
      "batteryCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://batteryservice:8080"
          }
        }
      },
      "ticketCluster": {
        "HttpClient": {
          "RequestVersion": "1.1",
          "RequestVersionPolicy": "RequestVersionOrLower"
        },
        "HttpRequest": {
          "ActivityTimeout": "00:01:30"
        },
        "Destinations": {
          "destination1": {
            "Address": "http://ticketservice:8080"
          }
        }
      },
      "notificationCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://notificationservice:8080"
          }
        }
      },
      "smsCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://smsservice:8080"
          }
        }
      },
      "auditAggregatorCluster": {
        "Destinations": {
          "destination1": {
            "Address": "http://auditaggregatorservice:8080"
          }
        }
      }
    }
  }
}
