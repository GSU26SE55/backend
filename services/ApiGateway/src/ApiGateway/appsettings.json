{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "ReverseProxy": {
    "Routes": {
      "auth-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/auth/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/auth/{**catch-all}"
          }
        ]
      },
      "accounts-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/accounts/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/accounts/{**catch-all}"
          }
        ]
      },
      "sessions-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/sessions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/sessions/{**catch-all}"
          }
        ]
      },
      "admin-accounts-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/accounts/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/admin/accounts/{**catch-all}"
          }
        ]
      },
      "admin-roles-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/roles/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/admin/roles/{**catch-all}"
          }
        ]
      },
      "admin-audit-logs-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/audit-logs/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/admin/audit-logs/{**catch-all}"
          }
        ]
      },
      "admin-audit-permissions-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/api/admin/permissions/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/admin/permissions/{**catch-all}"
          }
        ]
      },
      "files-route": {
        "ClusterId": "file-storage-cluster",
        "Match": {
          "Path": "/api/files/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/api/files/{**catch-all}"
          }
        ]
      },
      "auth-swagger-route": {
        "ClusterId": "auth-cluster",
        "Match": {
          "Path": "/auth-service/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      },
      "file-storage-swagger-route": {
        "ClusterId": "file-storage-cluster",
        "Match": {
          "Path": "/file-storage-service/swagger/{**catch-all}"
        },
        "Transforms": [
          {
            "PathPattern": "/swagger/{**catch-all}"
          }
        ]
      }
    },
    "Clusters": {
      "auth-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7000"
          }
        }
      },
      "file-storage-cluster": {
        "Destinations": {
          "destination1": {
            "Address": "https://localhost:7100"
          }
        }
      }
    }
  }
}
