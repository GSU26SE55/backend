<Project Sdk="Microsoft.NET.Sdk">

    <PropertyGroup>
        <TargetFramework>net8.0</TargetFramework>
        <ImplicitUsings>enable</ImplicitUsings>
        <Nullable>enable</Nullable>
        <IsPackable>false</IsPackable>
        <IsTestProject>true</IsTestProject>
    </PropertyGroup>

    <ItemGroup>
        <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.9.0" />
        <PackageReference Include="xunit" Version="2.7.0" />
        <PackageReference Include="xunit.runner.visualstudio" Version="2.5.7">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="FluentAssertions" Version="6.12.0" />
        <PackageReference Include="Moq" Version="4.20.70" />
        <PackageReference Include="MockQueryable.Moq" Version="7.0.0" />
        <PackageReference Include="Testcontainers.PostgreSql" Version="3.8.0" />
        <!-- AuditCreatedConsumer là đường vào duy nhất của read-store. Không có harness thì
             không kiểm được nó, và nhánh idempotent/geo-enrichment/race sẽ không ai chạm. -->
        <PackageReference Include="MassTransit" Version="8.5.9" />
        <PackageReference Include="MassTransit.TestFramework" Version="8.5.9" />
        <!-- DoD Sprint audit: cần collector này mới đo được coverage 80%. Trước 2026-08-01 project
             thiếu package nên chạy XPlat Code Coverage xong KHÔNG sinh ra file cobertura nào. -->
        <PackageReference Include="coverlet.collector" Version="6.0.2">
            <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
            <PrivateAssets>all</PrivateAssets>
        </PackageReference>
        <PackageReference Include="Microsoft.EntityFrameworkCore" Version="8.0.11" />
    </ItemGroup>

    <ItemGroup>
        <ProjectReference Include="..\..\src\AuditAggregatorService.Api\AuditAggregatorService.Api.csproj" />
        <ProjectReference Include="..\..\src\AuditAggregatorService.Application\AuditAggregatorService.Application.csproj" />
        <ProjectReference Include="..\..\src\AuditAggregatorService.Domain\AuditAggregatorService.Domain.csproj" />
        <ProjectReference Include="..\..\src\AuditAggregatorService.Infrastructure\AuditAggregatorService.Infrastructure.csproj" />
    </ItemGroup>

</Project>
