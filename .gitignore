# ---------- Environment files ----------
# Local: .env (đang dùng cho dotnet run)
.env
# Docker: .env.Docker (gitignored vì có secret thật)
.env.Docker
.env.Docker.example
.env.Production
.env.Staging
.env.local
# COMMIT: .env.Docker.example (template, không có secret)

# ---------- .NET build outputs ----------
bin/
obj/
*.user
*.suo

# ---------- Test coverage ----------
[Tt]est[Rr]esult*/
*.coverage
coverage/

# ---------- IDE ----------
.vs/
.vscode/
.idea/
*.swp
.DS_Store

# ---------- Gemini & Agents (Local only) ----------
.gemini/
AGENTS.md
*.skill
.claude.local/
coverage.runsettings
# ---------- Logs ----------
*.log
logs/

# ---------- Helm subchart cache (auto-download bằng `helm dependency update`) ----------
deploy/helm/*/charts/
.config/dotnet-tools.json

.dataprotection-keys/

