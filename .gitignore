# ---------- Environment files ----------
# Local: .env (đang dùng cho dotnet run)
.env
# Docker: .env.Docker (gitignored vì có secret thật)
.env.Docker
.env.Docker.example
.env.Production
.env.Staging
.env.local
docker-compose.override.yml
# COMMIT: .env.Docker.example (template, không có secret)

# Production deployment secrets/image locks stay on the VPS, never in Git.
deploy/production/*.env
!deploy/production/*.env.example

# ---------- .NET build outputs ----------
bin/
obj/
*.user
*.suo

# ---------- Test coverage ----------
[Tt]est[Rr]esult*/
*.coverage
coverage/

# ---------- IDE ----------
.vs/
.vscode/
.idea/
*.swp
.DS_Store

# ---------- Gemini & Agents (Local only) ----------
.gemini/
AGENTS.md
.claude.local/
coverage.runsettings
# ---------- Logs ----------
*.log
logs/

# ---------- Helm subchart cache (auto-download bằng `helm dependency update`) ----------
deploy/helm/*/charts/
.config/dotnet-tools.json

.dataprotection-keys/

# ---------- CodeGraph index (local code intelligence) ----------
.codegraph/

# ---------- Local Codex/agent scratch artifacts ----------
# Hot-patch publish outputs are generated locally and must never enter source control.
.tmp-codex/

# ---------- Playwright MCP artifacts (local only) ----------
.playwright-mcp/

# loop-engine — sinh tự động, không commit
.loop/out/
.loop/cache/
.loop/runs/
.loop/guard.json
.loop/last-run.json
.loop/dispute.md

# ---------- Test/coverage output (sinh tự động, không commit) ----------
CoverageResults/
IntegrationResults/

# ---------- GeoIP database (downloaded/generated locally) ----------
*.mmdb
