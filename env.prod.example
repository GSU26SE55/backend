# =====================================================================
# Solar Battery — LEGACY Docker Compose production environment template
# K3s production uses deploy/production/*.env.example instead of this file.
# If this legacy stack is used, copy this template to the VPS, replace every
# CHANGE_ME value there, and NEVER commit the populated file.
# =====================================================================

# --- VPS IP (cho ObjectStorage public URL) ---
VPS_IP=203.0.113.10

# ---------- Logging ----------
Logging__LogLevel__Default=Information
Logging__LogLevel__Microsoft.AspNetCore=Warning

Logging__Console__FormatterName=json
Logging__Console__FormatterOptions__SingleLine=true
Logging__Console__FormatterOptions__IncludeScopes=true
Logging__Console__FormatterOptions__TimestampFormat=yyyy-MM-ddTHH:mm:ss.fffZ
Logging__Console__FormatterOptions__UseUtcTimestamp=true
Logging__Console__FormatterOptions__JsonWriterOptions__Indented=false

AllowedHosts=*

# ---------- PostgreSQL ----------
POSTGRES_DB=solarbatterymaintainance
POSTGRES_USER=postgres
# ĐỔI thành password mạnh hơn cho production
POSTGRES_PASSWORD=CHANGE_ME_RANDOM_DATABASE_PASSWORD

AUTH_DB_NAME=auth_db
FILE_STORAGE_DB_NAME=file_storage_db
BATTERY_DB_NAME=battery_db
TICKET_DB_NAME=ticket_db
NOTIFICATION_DB_NAME=notification_db
SMS_DB_NAME=sms_db
AUDIT_AGGREGATOR_DB_NAME=audit_aggregate_db

# ---------- Redis ----------
ConnectionStrings__Redis=redis:6379

# ---------- RabbitMQ ----------
RabbitMQ__Host=rabbitmq
RabbitMQ__Username=solar-prod
RabbitMQ__Password=CHANGE_ME_RANDOM_RABBITMQ_PASSWORD

# ---------- JWT ----------
# ĐỔI SecretKey — chuỗi ngẫu nhiên ít nhất 32 ký tự
JwtSettings__SecretKey=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS
# KHÁC dev: dùng domain production thay cho localhost
JwtSettings__Issuer=https://api.solars.io.vn
JwtSettings__Audience=https://api.solars.io.vn
JwtSettings__AccessTokenExpirationMinutes=60
# ---------- Password Policy (production STRICT) ----------
PasswordPolicy__MinLength=12
PasswordPolicy__MaxLength=100
PasswordPolicy__RequireUppercase=true
PasswordPolicy__RequireLowercase=true
PasswordPolicy__RequireDigit=true
PasswordPolicy__RequireSpecialChar=true

# ---------- Auth Security (production: BẬT) ----------
AuthSecurity__EnforceDeviceBinding=true

# ---------- MailJet ----------
MailJet__ApiKey=CHANGE_ME_MAILJET_API_KEY
MailJet__ApiSecret=CHANGE_ME_MAILJET_API_SECRET
MailJet__FromEmail=CHANGE_ME_VERIFIED_SENDER@example.com
MailJet__DisplayName=Solar Panel Battery Maintainance
MailJet__SendEndpoint=https://api.mailjet.com/v3.1/send

EmailTemplates__Path=wwwroot/email-templates
EmailTemplates__CacheDisabled=false

# ---------- Object Storage (MinIO) ----------
ObjectStorage__Provider=Minio
ObjectStorage__ServiceUrl=http://minio:9000
ObjectStorage__BucketName=solar-battery-files
# GH-788 — SINH mới, KHÔNG chép nguyên mẫu. Copy nguyên `minioadmin` lên production nghĩa là bất kỳ
# ai cũng đăng nhập được console MinIO bằng credential đoán được, và console dùng chính root
# credential ⇒ toàn quyền trên mọi bucket.
#   ObjectStorage__AccessKey=$(openssl rand -hex 16)
#   ObjectStorage__SecretKey=$(openssl rand -base64 32)
# Để trống thì `docker compose up` DỪNG ngay (xem docker-compose.prod.yml), và FileStorageService
# cũng từ chối khởi động ở môi trường non-Development.
ObjectStorage__AccessKey=THAY-BANG-GIA-TRI-SINH-NGAU-NHIEN
ObjectStorage__SecretKey=THAY-BANG-GIA-TRI-SINH-NGAU-NHIEN
ObjectStorage__Region=us-east-1
ObjectStorage__ForcePathStyle=true
ObjectStorage__CreateBucketIfNotExists=true
# GH-788 — ĐỂ TRỐNG, giống dev. Bucket là private nên URL "public" không tải được; điền vào chỉ tạo
# ra link chết mà FE tưởng là dùng được. File tải qua FileStorageService (kiểm quyền) hoặc presigned
# URL có hạn — đó là đường duy nhất còn hiệu lực.
ObjectStorage__PublicBaseUrl=
# URL browser dùng để tải presigned link (Host phải khớp chữ ký) — chính là cổng S3 API đã publish.
ObjectStorage__PublicServiceUrl=https://files.solars.io.vn
ObjectStorage__MaxFileSizeBytes=10485760
ObjectStorage__AllowedExtensions__0=.jpg
ObjectStorage__AllowedExtensions__1=.jpeg
ObjectStorage__AllowedExtensions__2=.png
ObjectStorage__AllowedExtensions__3=.webp
ObjectStorage__AllowedExtensions__4=.pdf
ObjectStorage__AllowedExtensions__5=.doc
ObjectStorage__AllowedExtensions__6=.docx
ObjectStorage__AllowedExtensions__7=.xls
ObjectStorage__AllowedExtensions__8=.xlsx

# ---------- Google OAuth ----------
GoogleOAuth__ClientId=CHANGE_ME.apps.googleusercontent.com
GoogleOAuth__ClientSecret=CHANGE_ME_GOOGLE_OAUTH_CLIENT_SECRET
# redirect_uri PHẢI là trang FE, KHÔNG phải endpoint API. Trang FE /auth/google/callback nhận
# ?code&state rồi gọi GET /api/auth/google/callback bằng XHR (withCredentials) để đổi token.
# Login và exchange code phải dùng chính xác cùng một redirect URI đã đăng ký với Google.
# Nhớ khai đúng URI này trong Google Cloud Console > Authorised redirect URIs.
GoogleOAuth__RedirectUri=https://solars.io.vn/auth/google/callback
GoogleOAuth__AllowedRedirectUris__0=https://solars.io.vn/auth/google/callback
GoogleOAuth__Scope=openid email profile

# ---------- Admin Seed ----------
ADMIN_EMAIL=admin@solars.io.vn
# ĐỔI thành password mạnh
ADMIN_PASSWORD=CHANGE_ME_STRONG_ADMIN_PASSWORD

# ---------- SMS Gateway (Sprint SMS) ----------
# SmsService chuyển từ stub (FakeSmsSender) sang SMS Gateway Hub trung tâm:
#   - Nhận SendSmsCommand từ Auth/Battery/Ticket qua RabbitMQ
#   - Queue vào DB riêng (sms_db, conn string set ở compose smsservice block)
#   - Push qua SignalR cho Flutter app `sms_fowarder` gửi qua SIM thật
# Legacy biến `Sms__Provider`/`Sms__From` đã obsolete sau khi xoá FakeSmsSender + ISmsSender.
#
# Daily limit mặc định khi admin tạo device mới (admin có thể override per device).
Sms__DefaultDailyLimit=100

# ---------- Sprint 6.3 NOTI3-15 (#715) — hủy đăng ký một chạm ----------
# ⚠️ HAI biến dưới KHÔNG có giá trị mặc định trong code, và khi thiếu thì service vẫn khởi động
# bình thường — chỉ là email lặng lẽ mất header List-Unsubscribe. Không log lỗi, không alert.
# Gmail/Yahoo (quy định người gửi hàng loạt 2024) hạ uy tín tên miền khi thiếu header này,
# nên hậu quả chỉ lộ ra sau vài tuần dưới dạng tỷ lệ vào hộp thư tụt.
#
# Secret: khoá ký HMAC. ĐỔI giá trị trước khi chạy thật — đổi về sau sẽ vô hiệu hoá
#         mọi link hủy đã phát trong các email đã gửi đi.
#         Sinh khoá: openssl rand -base64 48
Notification__Unsubscribe__Secret=CHANGE_ME_RANDOM_UNSUBSCRIBE_HMAC_SECRET
# PublicBaseUrl: tên miền công khai THẬT của ApiGateway — Gmail POST thẳng vào URL này khi
#         người dùng bấm "Hủy đăng ký". Để localhost thì nút bấm không hoạt động với người nhận.
Notification__Unsubscribe__PublicBaseUrl=https://api.solars.io.vn
# Hạn dùng token (ngày). Email nằm trong hộp thư nhiều năm nên token không được vô hạn.
Notification__Unsubscribe__TokenLifetimeDays=180

# ---------- Sprint 6.3 — tham số vận hành NotificationService ----------
# Các biến dưới ĐỀU có mặc định trong code; liệt kê ở đây để prod chỉnh được mà không phải sửa code.
#
# Đối soát biên nhận Expo (NOTI3-02): ticket "ok" chỉ nghĩa là Expo NHẬN, chưa phải đã giao.
Notification__ExpoReceipt__Enabled=true
Notification__ExpoReceipt__MinAgeMinutes=15
Notification__ExpoReceipt__PollIntervalSeconds=300
# Bù SMS khi push critical không có biên nhận (NOTI3-05).
Notification__Fallback__Enabled=true
# PHẢI >= MinAgeMinutes(15) + chu kỳ quét(5) + biên(5) = 25. Đặt thấp hơn thì fallback bắn SMS
# trước khi worker đối soát kịp biết biên nhận ⇒ MỌI push critical lãnh thêm 1 SMS thừa,
# mà không có lỗi kỹ thuật nào để lần ra. Service ghi LogError lúc khởi động nếu đặt sai.
Notification__Fallback__PushReceiptTimeoutMinutes=30
# Hạn mức per-user (NOTI3-06). Vượt trần thì HOÃN vào digest, không vứt bỏ. Critical luôn bỏ qua.
Notification__RateLimit__Enabled=true
Notification__RateLimit__MaxPerUserPerHour=20
Notification__RateLimit__MaxPerUserPerType=8
# Dọn notification quá hạn (NOTI3-11). Type critical giữ vĩnh viễn làm bằng chứng đã cảnh báo.
Notification__Retention__Enabled=true
Notification__Retention__Days=90

# ---------- Outbox & Idempotency ----------
Outbox__BatchSize=50
Outbox__PollIntervalSeconds=2
Outbox__MaxRetries=10
Idempotency__Enabled=true
Idempotency__TtlHours=24
Inbox__TtlDays=7
Inbox__FailOpenWhenRedisDown=false

# ---------- Session ----------
Session__MaxConcurrentSessions=5

# ---------- Resilience (MassTransit retry) ----------
Resilience__MessageRetry__Limit=5
Resilience__MessageRetry__MinIntervalSeconds=1
Resilience__MessageRetry__MaxIntervalSeconds=30
Resilience__MessageRetry__IntervalDeltaSeconds=2
Resilience__ScheduledRedelivery__Enabled=true
Resilience__ScheduledRedelivery__IntervalsMinutes=5,15,30

# ---------- HTTP Client Timeout ----------
HttpClientTimeouts__GoogleOAuthSeconds=15
HttpClientTimeouts__MailjetSeconds=30
HttpClientTimeouts__DefaultSeconds=30

# ---------- Discord Webhook ----------
DISCORD_WEBHOOK=https://discord.com/api/webhooks/CHANGE_ME

# ---------- Battery Service ----------
BATTERY_SENSOR_INGEST_API_KEY=CHANGE_ME_AT_LEAST_32_RANDOM_CHARACTERS

BATTERY_ANOMALY_SCAN_INTERVAL_SECONDS=10   # IOT3-80 — 30→10 s: quét là đọc, không ghi, nên gần như miễn phí
BATTERY_ANOMALY_DEDUP_WINDOW_MINUTES=30
BATTERY_ANOMALY_OFFLINE_THRESHOLD_MINUTES=10
BATTERY_ANOMALY_ESCALATION_AFTER_MINUTES=1
BATTERY_ANOMALY_ESCALATION_INTERVAL_SECONDS=60
BATTERY_ANOMALY_OUTBOX_RELAY_INTERVAL_SECONDS=5
BATTERY_ANOMALY_OUTBOX_RELAY_BATCH_SIZE=100

# ---------- Grafana ----------
GRAFANA_ADMIN_PASSWORD=CHANGE_ME_STRONG_GRAFANA_PASSWORD

# ---------- Image tag (Jenkins tự override, không cần sửa) ----------
IMAGE_TAG=staging


# ---------- BatteryService #91/#92 — Environmental ingest API key ----------
# ĐỔI key production — chỉ IoT environmental detector device biết
BATTERY_ENVIRONMENTAL_INGEST_API_KEY=CHANGE_ME_PROD_ENV_KEY

# ---------- BatteryService #90/#92 — Weather (OpenMeteo) ----------
BATTERY_WEATHER_BASE_URL=https://api.open-meteo.com/
BATTERY_WEATHER_INTERVAL_MINUTES=15
BATTERY_WEATHER_DEDUP_WINDOW_MINUTES=10
BATTERY_WEATHER_HTTP_TIMEOUT_SECONDS=10
BATTERY_WEATHER_ENABLED=true

# ---------- Battery + Ticket #235 — MassTransit endpoint runtime ----------
# Prod: pre-fetch cao hơn dev cho throughput tốt
MESSAGE_BUS_PREFETCH_COUNT=32
MESSAGE_BUS_CONCURRENT_LIMIT=16

# ---------- TicketService #238 — Alert-Ticket Saga feature flags ----------
# Maintenance window: tạm set ALERT_TICKET_DISPATCH_ENABLED=false để pause flow.
ALERT_TICKET_DISPATCH_ENABLED=true
ALERT_TICKET_SAGA_ENABLED=true

# ---------- Sprint IoT-1 #248 — IoT offline detection ----------
# Tick interval cho IotDeviceOfflineDetectionBackgroundService.
# Khuyến nghị giữ 60s production — tăng lên 120s nếu DB load cao.
Iot__OfflineCheckIntervalSeconds=60
# Threshold sau bao lâu device mất heartbeat thì mark Offline + tạo Alert DeviceOffline.
# Khuyến nghị: 5x heartbeat interval của ESP32 (60s heartbeat → 300s threshold).
Iot__OfflineAfterSeconds=300
# Số device tối đa 1 tick xử lý — tránh long-running transaction khi hàng nghìn device cùng mất mạng.
Iot__OfflineBatchSize=100

# ---------- Sprint IoT-1 #253 — MQTT bridge (P3, optional) ----------
# Set true khi đã deploy Mosquitto broker + cấp credential per-device. Default false để skip cho deployment chỉ dùng HTTPS.
Mqtt__Enabled=true
# Hostname nội bộ trong docker network production (vd service `mosquitto`).
Mqtt__Host=mqtt.solars.io.vn
# 8883 = TLS production. 1883 plain CHỈ dùng debug local, không expose port này ra ngoài.
Mqtt__Port=8883
# DNS public trả về cho ESP32; không dùng hostname chỉ tồn tại trong Docker.
Mqtt__PublicHost=mqtt.solars.io.vn
Mqtt__PublicPort=8883
Mqtt__UseTls=true
# Production: dùng cert ký bởi CA tin cậy (Let's Encrypt) → set FALSE.
Mqtt__AllowUntrustedCertificates=false
Mqtt__Username=backend-bridge
# ĐỔI password production — generate bằng `mosquitto_passwd -c passwd backend-bridge "$(openssl rand -base64 32)"`.
Mqtt__Password=CHANGE_ME_PROD_MQTT_PASSWORD
Mqtt__ClientId=battery-service-bridge
Mqtt__ReconnectIntervalSeconds=5
# IOT3-17/20 — bắt buộc để MqttPasswordFileSyncService chạy. Xem docker-compose.prod.yml:
# batteryservice phải bind mount thư mục chứa passwd của broker vào /mosquitto-config (rw).
Mqtt__PasswordFilePath=/mosquitto-config/passwd
Mqtt__CredentialSyncIntervalSeconds=60

# Sprint BE-IoT-Realtime — SSE telemetry (overall.md §34.10)
Realtime__Enabled=true
Realtime__HeartbeatSeconds=30
Realtime__SummaryIntervalSeconds=4

# ---------- Sprint IoT-2 #IoT2-35 — Firmware OTA storage ----------
# Path trong container batteryservice — phải bind mount volume từ host để giữ file qua restart.
# Production: nên dùng object storage (S3/MinIO) thay vì local FS — set PublicBaseUrl trỏ tới CDN/bucket.
Firmware__StorageRoot=/data/firmware-storage
# Public URL prefix cho download artifact. Để trống = backend serve qua /firmware-storage/{file}
# (cần expose port + reverse proxy). Production khuyến nghị: presigned URL từ object storage.
# Ví dụ: https://battery.solar.production.com/firmware
Firmware__PublicBaseUrl=

# ---------- GH-295 — Data Protection (encrypt 2FA TwoFactorSecret at rest) ----------
# Path bên trong container authservice — phải bind mount volume `auth-dataprotection-keys`
# từ host để key persist qua container restart.
# ⚠️ CRITICAL: nếu volume này mất / không backup → mọi 2FA secret đã encrypt trong DB sẽ
# KHÔNG decrypt được → user bị lock khỏi 2FA, phải admin reset từng người.
# OPS: backup volume `auth-dataprotection-keys` cùng schedule với Postgres backup.
DataProtection__KeysPath=/app/keys

# ---------- OpenTelemetry (Sprint 7 #116) ----------
# Tracing → Tempo. Trỏ tới OTLP gRPC endpoint của Tempo. Trống = tắt.
OpenTelemetry__OtlpEndpoint=http://tempo:4317

# Sprint 7 #115 — ApiGateway rate limit (mặc định 100 request / 10s / user|IP). Bỏ qua nếu dùng default.
RateLimiting__PermitLimit=100
RateLimiting__WindowSeconds=10

GeoIp__DbPath=/app/geoip/GeoLite2-City.mmdb

# ---------- AI Configuration (Sprint 7 #CHAT-04) ----------
# Provider cho AI text/suggestion clients: "Gemini" hoặc "DeepSeek"
Chat__Provider=Gemini

# Gemini AI configuration
GEMINI_API_KEY=YOUR_GEMINI_API_KEY_HERE
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_VOICE_MODEL=gemini-2.5-flash

Chat__Ai__ApiKey=YOUR_GEMINI_API_KEY_HERE
Chat__Ai__ModelName=gemini-2.0-flash-lite
Chat__Ai__MaxSuggestionsPerCall=3
Chat__Ai__TimeoutSeconds=30
Chat__Ai__PiiMaskTtlHours=1
Chat__Ai__SentimentAlertThreshold=-0.7
Chat__Ai__SummarizeLinesCount=5
Chat__Ai__SentimentAnalysisMaxChats=20

# Voice transcribing configurations
Chat__Voice__ModelName=gemini-2.5-flash
Chat__Voice__TranscribeTimeoutSeconds=30
Chat__Voice__FileStorageUploadUrl=http://filestorageservice:8080/api/files/upload

# DeepSeek AI configuration
DEEPSEEK_API_KEY=YOUR_DEEPSEEK_API_KEY_HERE
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

Chat__DeepSeek__ApiKey=YOUR_DEEPSEEK_API_KEY_HERE
Chat__DeepSeek__BaseUrl=https://api.deepseek.com
Chat__DeepSeek__Model=deepseek-chat
Chat__DeepSeek__TimeoutSeconds=30

# ---------- GH-790 — kênh gRPC nội bộ FileStorage ↔ TicketService ----------
# BẮT BUỘC. Thiếu là FileStorageService KHÔNG khởi động được:
# Program.cs ném InvalidOperationException("FILE_STORAGE_SERVICE_GRPC_SERVER_PORT (or Grpc:Port)
# must be configured."). Dev (.env / .env.Docker) đã có hai biến này từ lâu; riêng bản mẫu
# production bỏ sót — nên cả voice transcription lẫn quét virus đính kèm đều không có đường chạy.
#
# Cổng phải KHÁC 8080 (cổng HTTP) — Program.cs cũng chặn trường hợp trùng.
FILE_STORAGE_SERVICE_GRPC_SERVER_PORT=8081
FILE_STORAGE_GRPC_CLIENT_ADDRESS=http://filestorageservice:8081

# ---------- CORS (#AUTH-05) — BẮT BUỘC ở Production ----------
# docker-compose.prod.yml khai `${Cors__AllowedOrigins__0:?...}` cho MỌI service, nên thiếu là
# `docker compose up` dừng ngay. Bản mẫu này trước đây bỏ sót (lỗi có sẵn, phát hiện khi rà nối dây
# cho GH-790): dùng đúng file mẫu để deploy sẽ hỏng ở dòng đầu tiên.
# Origin = scheme + host (+ port nếu khác 443/80). KHÔNG kèm path, KHÔNG có '/' cuối.
Cors__AllowedOrigins__0=https://solars.io.vn
Cors__AllowedOrigins__1=
Cors__AllowedOrigins__2=

# ---------- AI module (public TLS origin; /docs is Swagger only) ----------
Ai__Enabled=true
Ai__GrpcAddress=https://ai.solars.io.vn
Ai__HttpBaseUrl=https://ai.solars.io.vn
Ai__TimeoutSeconds=5
TicketAi__Enabled=true
TicketAi__AiGrpcAddress=https://ai.solars.io.vn
TicketAi__TimeoutSeconds=5
