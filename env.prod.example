GoogleOAuth__ClientId=85758470906-dhc3h3iiv52o77g7a8odqti5316j67cc.apps.googleusercontent.com
GoogleOAuth__ClientSecret=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
# KHÁC dev: trỏ về production gateway
# Nhớ thêm redirect URI này vào Google Cloud Console
