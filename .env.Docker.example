# Docker Compose env template.
# Copy to .env.Docker, fill real secrets, then run:
# docker compose --env-file .env.Docker up -d --build

# Postgres server/admin database used by the Postgres container itself.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Logical database per backend service.
AUTH_DB_NAME=auth_db
FILE_STORAGE_DB_NAME=file_storage_db

# Optional comma-separated extra database names for future services.
# SERVICE_DATABASES=maintenance_db
