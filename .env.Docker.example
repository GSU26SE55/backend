# Docker Compose env template.
# Copy to .env.Docker, fill real secrets, then run:
# docker compose --env-file .env.Docker up -d --build

# Postgres server/admin database used by the Postgres container itself.
POSTGRES_DB=postgres
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me

# Logical database per backend service.
AUTH_DB_NAME=auth_db
FILE_STORAGE_DB_NAME=file_storage_db
BATTERY_DB_NAME=battery_db
TICKET_DB_NAME=ticket_db
NOTIFICATION_DB_NAME=notification_db
SMS_DB_NAME=sms_db

# BatteryService IoT ingest key used by POST /api/sensor-readings/batch.
BATTERY_SENSOR_INGEST_API_KEY=change-me

# TicketService — AI provider switch ("Gemini" default hoặc "DeepSeek")
CHAT_PROVIDER=Gemini

# Gemini AI — luôn cần cho voice transcription dù dùng DeepSeek
# Lấy key tại https://aistudio.google.com/apikey
GEMINI_API_KEY=change-me
GEMINI_MODEL=gemini-2.0-flash-lite
GEMINI_VOICE_MODEL=gemini-2.5-flash

# DeepSeek AI — điền key khi CHAT_PROVIDER=DeepSeek
# Lấy key tại https://platform.deepseek.com/api-keys
DEEPSEEK_API_KEY=change-me
DEEPSEEK_BASE_URL=https://api.deepseek.com
DEEPSEEK_MODEL=deepseek-chat

# Optional comma-separated extra database names for future services.
# SERVICE_DATABASES=maintenance_db

# ---------- Frontend ----------
# Web app base URL — generate link redirect trong email (cross-device 2FA confirm #AUTH-51).
# Production phải dùng HTTPS public URL, KHÔNG trailing slash.
Frontend__WebBaseUrl=https://app.example.com

# ---------- Kênh gRPC nội bộ FileStorage ↔ TicketService (GH-790) ----------
# BẮT BUỘC. docker-compose.yml khai hai biến này dạng ${VAR:?...}, nên thiếu là
# `docker compose up` DỪNG NGAY — đây chính là lỗi đầu tiên gặp phải khi làm đúng hướng dẫn
# "copy file này thành .env.Docker rồi chạy" ở đầu file.
# Dùng cho voice transcription và quét virus đính kèm. Cổng phải KHÁC 8080 (cổng HTTP).
FILE_STORAGE_SERVICE_GRPC_SERVER_PORT=8081
FILE_STORAGE_GRPC_CLIENT_ADDRESS=http://filestorageservice:8081
